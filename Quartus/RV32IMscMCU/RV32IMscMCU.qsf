set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY RV32IMscMCU
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 21.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "23:52:42  JULY 14, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "21.1.0 Lite Edition"
set_global_assignment -name SDC_FILE RV32IMscMCU.sdc
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/RV32IMscMCU.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/RV32IM_CORE.vhd
# Phase 5A/5B. ADDR_DECODER is instantiated by RV32IMscMCU.vhd (the DEC instance),
# so it MUST be here or Analysis & Synthesis fails to bind the component -- there
# is no SEARCH_PATH assignment in this project, and Quartus resolves a component
# only from the file list.
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/ADDR_DECODER.vhd
# Phase 4A. Instantiated four times by DIV_UNIT (Phase 7B1) -- its first real
# use -- and later by the UART. DIV_UNIT is not itself instantiated until 7B2, so
# for now synthesis still prunes the whole subtree and it costs nothing here.
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/SYNC.vhd
# Phase 7A. Figure 9's division accelerator, in the same not-yet-instantiated
# state as SYNC above and listed for exactly the same reason: so it is analysed,
# and so the two file lists stay in step.
#
# CORRECTION TO AN EARLIER VERSION OF THIS COMMENT. It claimed that listing the
# file here would make Quartus report div_accel's area and DIVCLK Fmax, and the
# plan turned that into a deliverable. That was FALSE, and it contradicted the
# SYNC comment nine lines above in this same file, which states the true
# behaviour: synthesis prunes an uninstantiated entity. TOP_LEVEL_ENTITY is
# RV32IMscMCU, nothing instantiates div_accel yet, and nothing drives divclk_i --
# so the block is elaborated and dropped, contributes no row to the resource
# table, and presents no clock for the Timing Analyzer to report an Fmax on.
# Getting those two numbers needs either Phase 7B's instantiation or a dedicated
# revision with TOP_LEVEL_ENTITY div_accel plus a create_clock on divclk_i; that
# is a Phase 14 item, not something this line buys.
#
# LESSON, BECAUSE IT COST A BLOCKER ONCE:
# this project has TWO file lists - SIM/RV32IMscMCU/compile.do for ModelSim and
# this .qsf for Quartus - and there is no SEARCH_PATH, so a file added to only
# one of them binds in one tool and fails in the other.
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/DIV_ACCEL.vhd
# Phase 7B1/7B2. DIV_UNIT wraps DIV_ACCEL with the four clock-domain crossings,
# the MCLK-side handshake and the signed div/rem wrapper, and RV32IM_CORE now
# instantiates it -- so this subtree is LIVE and appears in the resource tables.
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/DIV_UNIT.vhd
# Phase 6A. Both instantiated by RV32IMscMCU.vhd (P_LEDR/P_HEX0..5 and the SEGGEN
# generate), so both must be listed here.
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/GPO_PORT.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/HEX_DECODER.vhd
# Phase 6B. Instantiated nine times by RV32IMscMCU.vhd (eight readable registers
# plus the bus terminator), so it must be listed.
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/BIDIRPIN.vhd

set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/PLL.vhd
# Phase 4B. PLL_GEN.vhd is PLL.vhd with the ratio, the input period, the device
# family and the CBX hint promoted to generics -- PLL.vhd's entity has no
# generics at all, so three instances of it would give three copies of ONE
# frequency. PLL.vhd is left byte-identical and the core still instantiates it.
# CLOCK_TREE.vhd is Figure 1's block: three pll_gen instances, per forum answer
# F6. AS OF PHASE 4C BOTH ARE LIVE: RV32IMscMCU instantiates CLOCK_TREE, clk_i
# reaches it and nothing else, and the core receives mclk. AS OF PHASE 7B2 expect
# THREE PLLs in the resource report -- the divider gives accelclk a load, so the
# third instance is no longer pruned. Two would mean the divider is being
# optimised away.
#
# TWO THINGS ONLY THIS TOOL CAN ANSWER, both in PLL_GEN.vhd's header:
#   1. the family string says "Cyclone II" while FAMILY above is "Cyclone IV E".
#      Inherited from PLL.vhd, and Lab 5 compiled and ran on the board with it.
#      Left at the known-working value; pass DEVICE_FAMILY => "Cyclone IV E" if
#      Quartus rejects a PLL parameter.
#   2. three instances with different parameters share one CBX_MODULE_PREFIX.
#      Normally correct. If Quartus reports colliding megafunction parameters,
#      give each instance its own LPM_HINT_STR.
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/PLL_GEN.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/CLOCK_TREE.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/MUL16.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/IFETCH.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/IDECODE.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/EXECUTE.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/DMEMORY.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/CONTROL.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/const_package.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/cond_compilation_package.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMscMCU/aux_package.vhd
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name VHDL_SHOW_LMF_MAPPING_MESSAGES OFF
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

# ============================================================================
# PIN ASSIGNMENTS -- STILL MISSING, DELIBERATELY. READ THIS BEFORE THE FIRST
# PINNED COMPILE.
# ============================================================================
# This revision has NO set_location_assignment at all. That was fine while the
# design's only ports were clk_i and rst_i plus Signal-Tap taps: it is the
# "performance" revision of the two-revision pattern (clause 6's PPA tables and
# Auxilary/Lab4/Quartus/Lab4_perf.sdc), where Quartus is free to place I/O
# anywhere and Fmax is the only number wanted.
#
# Phase 6A added real board outputs: LEDR_o[7..0] and HEX0_o..HEX5_o[6..0], which
# is 8 + 42 = 50 pins; Phase 6B added the input SW_i[7..0] for 8 more; and Phase 6C
# added KEY_i[3..1] for 3 - 61 in total, plus clk_i and rst_i (KEY0). Phase 8 will
# add three more on the expansion header for PWMout, CAPIN1 and CAPIN2, which
# Hanan's forum confirms you must choose yourself. Those need locations before anything can be tested on the
# DE2-115, and:
#
#   >>> THE PIN NUMBERS ARE NOT IN ANY FILE THE COURSE SUPPLIED. <<<
#
# Verified, and stated precisely because an earlier version of this note was
# over-broad: five .qsf files under Auxiliary/ DO contain set_location_assignment
# lines (the two Lab 5 Quartus projects in each of the two Lab 5 copies, and the
# USART option1 example). What none of them contains -- and what
# Auxilary/QUARTUS/pinPlanner/DE2-115_pinLocation.txt, a 28-line student note
# covering clk_i, rst_i and BPADDR_i[7..0], also does not contain -- is a single
# pin number for LEDR or any HEX display. Checked with
#   grep -rn "set_location_assignment.*\(LEDR\|HEX\)" Auxiliary/
# which returns nothing. This is gap G-504.
#
# So the numbers must come from outside the course material, which means saying
# so in the report. The normal source is Terasic's own DE2-115 System CD, which
# ships a DE2_115.qsf carrying every board pin; the assignments for LEDR and
# HEX0-HEX5 are copied from there. Do NOT type pin numbers from memory or from a
# web page - a wrong assignment on an output pin can drive against a fixed net.
#
# ADAR: when you add them, add them as a separate commit that touches only this
# file, so a pin mistake never gets tangled up with an RTL change.
# ============================================================================
