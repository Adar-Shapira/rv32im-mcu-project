set_location_assignment PIN_AE18 -to HEX4_o[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX4_o

# --- HEX5 ---
set_location_assignment PIN_AD18 -to HEX5_o[0]
set_location_assignment PIN_AC18 -to HEX5_o[1]
set_location_assignment PIN_AB18 -to HEX5_o[2]
