set_location_assignment PIN_AG25 -to GPIO[22]
set_location_assignment PIN_AD25 -to GPIO[23]
set_location_assignment PIN_AH25 -to GPIO[24]
set_location_assignment PIN_AE25 -to GPIO[25]
set_location_assignment PIN_AG22 -to GPIO[26]
set_location_assignment PIN_AE24 -to GPIO[27]
set_location_assignment PIN_AH22 -to GPIO[28]
set_location_assignment PIN_AF26 -to GPIO[29]
set_location_assignment PIN_AE20 -to GPIO[30]
set_location_assignment PIN_AG23 -to GPIO[31]
set_location_assignment PIN_AF20 -to GPIO[32]
set_location_assignment PIN_AH26 -to GPIO[33]
set_location_assignment PIN_AH23 -to GPIO[34]
set_location_assignment PIN_AG26 -to GPIO[35]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO

# PWM_o / CAPIN*_i are ModelSim copies on RV32IMpipelinedMCU, not ports of
# RV32IMpipelinedMCU_FPGA. Balls are GPIO[8]/[9]/[10].

# --- Clause 9 / 6.iv: the USART's two RS-232 pins (Phase 12B) ---
# Locations and I/O standard from the course's own Terasic table,
# Auxiliary/Lab4/Auxiliary/DE2_115_pin_assignments.csv:
#     UART_RXD, Input,  PIN_G12, 3.3-V LVTTL
#     UART_TXD, Output, PIN_G9,  3.3-V LVTTL
# UART_CTS (PIN_G14) and UART_RTS (PIN_J13) are in that table too but this
# USART is 8N1 with no hardware flow control, so they are deliberately left
# unassigned rather than tied to an invented level.
set_location_assignment PIN_G12 -to UART_RXD_i
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_RXD_i
set_location_assignment PIN_G9 -to UART_TXD_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_TXD_o

# Observation / BPADDR / PWM_o are not ports of RV32IMpipelinedMCU_FPGA.
# SignalTap taps GPIO[9] / KEY_i at this top (stp_pwm.stp).

# SignalTap for interrupt test4 PWM (no scope). Transcribed from
# Quartus/RV32IMscMCU/RV32IMscMCU.qsf + stp_pwm.stp. Same net Lab 4
# tapped as GPIO[9] (Auxiliary/Lab4/Quartus/stp1.stp). Clock is clk_i =
# CLOCK_50. Depth 16384 @ 50 MHz ~ 328 us, enough for one 5 kHz period
# (200 us). Ports are identical on this top (GPIO[9], KEY_i[3:1], clk_i).
# SIGNAL-TAP: SHIPPED OFF, ON FOR THE CAPTURES -- decided 2026-08-27
# Clause 7 makes SignalTap validation mandatory, so stp_pwm.stp is part of the
# submission and the two assignments naming it stay here. But ENABLE_SIGNALTAP
# ships OFF, for a specific reason: the inspection protocol's part 0 compiles
# the submitted design "without the Signal Tap file" and burns it on the spot
# (DOC/04 section 9.1). Pinned with SignalTap OFF is a SEVENTH configuration --
# neither the three performance revisions, which have no pins and cannot be
# burned, nor the three hardware revisions, which have SignalTap on -- and it
# is the one the grade actually runs. Shipping it as the default state means
# the room's compile works out of the box.
#
# For the mandatory captures, flip this one line to ON. Nothing else changes:
# the pins, the .stp and the SLD_NODE assignments below are already here.
# Expect the memory-bit count to jump when it is ON -- that is the
# instrumentation, and it is exactly why the PPA numbers must come from a
# revision with it OFF (D-2: Lab 5 reported 483,328 bits where the design uses
# 131,072).
set_global_assignment -name ENABLE_SIGNALTAP OFF
set_global_assignment -name USE_SIGNALTAP_FILE stp_pwm.stp
set_global_assignment -name SIGNALTAP_FILE stp_pwm.stp


# REMOVED 2026-08-27: this line was
#     set_global_assignment -name SLD_FILE db/stp_pwm_auto_stripped.stp
# It points into db/, which is Quartus's own build output -- present on the
# machine that last compiled and in no clean clone, no ZIP, and no inspection-
# room download. Clause 10 forbids "files that are a result of compilation" in
# the submission, so db/ cannot be shipped to satisfy it either. Quartus writes
# this line itself when it processes the .stp, so removing it costs nothing and
# a fresh compile from the packaged files no longer starts with a missing file.

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top