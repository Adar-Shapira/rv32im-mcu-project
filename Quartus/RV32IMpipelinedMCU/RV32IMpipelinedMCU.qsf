set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
# Board-only wrapper in RV32IMpipelinedMCU.vhd. Same reason as the SC
# project: compiling RV32IMpipelinedMCU as top produced 353 virtual pins.
set_global_assignment -name TOP_LEVEL_ENTITY RV32IMpipelinedMCU_FPGA
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 21.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "00:22:21  JULY 15, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "21.1.0 Lite Edition"
set_global_assignment -name SDC_FILE RV32IMpipelinedMCU.sdc
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMpipelinedMCU/RV32IMpipelinedMCU.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMpipelinedMCU/RV32IM_PIPE_CORE.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMpipelinedMCU/PLL.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMpipelinedMCU/PLL_GEN.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMpipelinedMCU/CLOCK_TREE.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMpipelinedMCU/ADDR_DECODER.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMpipelinedMCU/BIDIRPIN.vhd
