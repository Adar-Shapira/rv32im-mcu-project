set_instance_assignment -name VIRTUAL_PIN ON -to dtcm_wren_o

# SignalTap for interrupt test4 PWM (no scope). Transcribed from
# Quartus/RV32IMscMCU/RV32IMscMCU.qsf + stp_pwm.stp. Same net Lab 4
# tapped as GPIO[9] (Auxiliary/Lab4/Quartus/stp1.stp). Clock is clk_i =
# CLOCK_50. Depth 16384 @ 50 MHz ~ 328 us, enough for one 5 kHz period
# (200 us). Ports are identical on this top (GPIO[9], KEY_i[3:1], clk_i).
set_global_assignment -name ENABLE_SIGNALTAP ON
set_global_assignment -name USE_SIGNALTAP_FILE stp_pwm.stp
set_global_assignment -name SIGNALTAP_FILE stp_pwm.stp

set_global_assignment -name SLD_NODE_CREATOR_ID 110 -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_ENTITY_NAME sld_signaltap -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_clk -to clk_i -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_trigger_in[0] -to GPIO[9] -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_trigger_in[1] -to KEY_i[1] -section_id auto_signaltap_0
