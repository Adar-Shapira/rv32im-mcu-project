set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX5_o

# --- Expansion header J15 / JP5: GPIO[35:0] (Terasic CSV).
# PWM = GPIO[9] (Figure 4b). CAPIN1 = GPIO[8], CAPIN2 = GPIO[10].
# PWM_o/CAPIN*_i are VIRTUAL_PIN copies for ModelSim; the balls belong to GPIO[].
set_location_assignment PIN_AB22 -to GPIO[0]
set_location_assignment PIN_AC15 -to GPIO[1]
