set_global_assignment -name VHDL_FILE ../../DUT/RV32IMpipelinedMCU/UART_CORE.vhd
set_global_assignment -name VHDL_FILE ../../DUT/RV32IMpipelinedMCU/UART_PERIPH.vhd
