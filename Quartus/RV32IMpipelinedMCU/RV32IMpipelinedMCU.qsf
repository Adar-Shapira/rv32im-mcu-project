set_location_assignment PIN_H22 -to HEX0_o[6]
set_instance_assignment -name IO_STANDARD "2.5 V" -to HEX0_o

# --- HEX1 ---
set_location_assignment PIN_M24 -to HEX1_o[0]
set_location_assignment PIN_Y22 -to HEX1_o[1]
