set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX3_o[6]

# --- HEX4 ---
set_location_assignment PIN_AB19 -to HEX4_o[0]
set_location_assignment PIN_AA19 -to HEX4_o[1]
