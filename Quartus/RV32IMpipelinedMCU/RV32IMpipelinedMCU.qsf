set_location_assignment PIN_U24 -to HEX1_o[6]
set_instance_assignment -name IO_STANDARD "2.5 V" -to HEX1_o

# --- HEX2 ---
set_location_assignment PIN_AA25 -to HEX2_o[0]
set_location_assignment PIN_AA26 -to HEX2_o[1]
