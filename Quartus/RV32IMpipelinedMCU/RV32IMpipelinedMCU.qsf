set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name VHDL_SHOW_LMF_MAPPING_MESSAGES OFF
# F6: two pll_gen instances (MCLK + ACCEL; SMCLK shares MCLK). Copied from
# Quartus/RV32IMscMCU/RV32IMscMCU.qsf -- same CLOCK_TREE. Without this the
# Fitter merges them into one physical PLL (the default AUTO_MERGE_PLLS ON).
set_global_assignment -name AUTO_MERGE_PLLS OFF
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

# ============================================================================
# PIN ASSIGNMENTS -- transcribed from Quartus/RV32IMscMCU/RV32IMscMCU.qsf
# ============================================================================
# The PDF does not list FPGA ball numbers. Balls / I/O standards are Lab 5
# (clk, KEY0) + Lab4_HW.qsf / Terasic CSV (SW, KEY, LEDR, HEX, GPIO).
# Board ports are identical on RV32IMpipelinedMCU_FPGA. Observation ports
# (Figure 8 five-stage set, BPADDR_i) stay on RV32IMpipelinedMCU for ModelSim
# and are not part of this chip top — that is what makes virtual pins = 0.
# ============================================================================

# Unused FPGA balls must not drive populated DE2-115 nets.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED WITH WEAK PULL-UP"

# --- Clock and KEY0 reset (Lab 5) ---
set_location_assignment PIN_Y2 -to clk_i
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_i
set_location_assignment PIN_M23 -to rst_i
set_instance_assignment -name IO_STANDARD "2.5 V" -to rst_i

# --- Clause 4: SW9-SW0. PORT_SW MMIO is SW7-0 (clause 5). ---
set_location_assignment PIN_AB28 -to SW_i[0]
set_location_assignment PIN_AC28 -to SW_i[1]
set_location_assignment PIN_AC27 -to SW_i[2]
set_location_assignment PIN_AD27 -to SW_i[3]
set_location_assignment PIN_AB27 -to SW_i[4]
set_location_assignment PIN_AC26 -to SW_i[5]
set_location_assignment PIN_AD26 -to SW_i[6]
set_location_assignment PIN_AB26 -to SW_i[7]
set_location_assignment PIN_AC25 -to SW_i[8]
set_location_assignment PIN_AB25 -to SW_i[9]
set_instance_assignment -name IO_STANDARD "2.5 V" -to SW_i

# --- KEY3-1 (clause 6.i). KEY0 is rst_i above. ---
set_location_assignment PIN_M21 -to KEY_i[1]
set_location_assignment PIN_N21 -to KEY_i[2]
set_location_assignment PIN_R24 -to KEY_i[3]
set_instance_assignment -name IO_STANDARD "2.5 V" -to KEY_i

# --- Clause 4: LEDR9-LEDR0. PORT_LEDR MMIO is LEDR7-0 (clause 5). ---
