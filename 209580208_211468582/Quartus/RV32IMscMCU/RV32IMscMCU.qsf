set_location_assignment PIN_AB25 -to SW_i[9]
set_instance_assignment -name IO_STANDARD "2.5 V" -to SW_i

# --- KEY3-1 (clause 6.i). KEY0 is rst_i above. ---
set_location_assignment PIN_M21 -to KEY_i[1]
set_location_assignment PIN_N21 -to KEY_i[2]
set_location_assignment PIN_R24 -to KEY_i[3]
