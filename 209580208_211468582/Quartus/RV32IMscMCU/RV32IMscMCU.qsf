# PWM_o / CAPIN1_i / CAPIN2_i are NOT top-level ports of RV32IMscMCU_FPGA.
# Capture/PWM use GPIO[8]/[9]/[10]. ModelSim still has the copy ports on
# RV32IMscMCU.

# --- Clause 9 / 6.iv: the USART's two RS-232 pins (Phase 12B) ---
# Locations and I/O standard from the course's own Terasic table,
# Auxiliary/Lab4/Auxiliary/DE2_115_pin_assignments.csv:
#     UART_RXD, Input,  PIN_G12, 3.3-V LVTTL
#     UART_TXD, Output, PIN_G9,  3.3-V LVTTL
# UART_CTS (PIN_G14) and UART_RTS (PIN_J13) are in that table too but this
# USART is 8N1 with no hardware flow control, so they are deliberately left
# unassigned rather than tied to an invented level.
set_location_assignment PIN_G12 -to UART_RXD_i
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_RXD_i
set_location_assignment PIN_G9 -to UART_TXD_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_TXD_o

# Observation ports are not on RV32IMscMCU_FPGA. SignalTap taps GPIO[9] /
# KEY_i at this top (stp_pwm.stp); core probes are hierarchical inside MCU.

# SignalTap for test4 PWM (no scope). Same net Lab 4 tapped as GPIO[9]
# (Auxiliary/Lab4/Quartus/stp1.stp + Lab4_HW.qsf ENABLE_SIGNALTAP).
# Clock is clk_i = CLOCK_50, matching Lab 4's acq_clk = CLOCK_50.
# Depth 16384 @ 50 MHz ~ 328 us, enough for one 5 kHz period (200 us).
# Quartus fills the SLD node assignments from this file on compile
# (same pattern as Lab 5 RV32IM_CORE.qsf ENABLE_SIGNALTAP / SIGNALTAP_FILE).
# SIGNAL-TAP: SHIPPED OFF, ON FOR THE CAPTURES -- decided 2026-08-27
# Clause 7 makes SignalTap validation mandatory, so stp_pwm.stp is part of the
# submission and the two assignments naming it stay here. But ENABLE_SIGNALTAP
# ships OFF, for a specific reason: the inspection protocol's part 0 compiles
# the submitted design "without the Signal Tap file" and burns it on the spot
# (DOC/04 section 9.1). Pinned with SignalTap OFF is a SEVENTH configuration --
# neither the three performance revisions, which have no pins and cannot be
# burned, nor the three hardware revisions, which have SignalTap on -- and it
# is the one the grade actually runs. Shipping it as the default state means
# the room's compile works out of the box.
#
# For the mandatory captures, flip this one line to ON. Nothing else changes:
# the pins, the .stp and the SLD_NODE assignments below are already here.
# Expect the memory-bit count to jump when it is ON -- that is the
# instrumentation, and it is exactly why the PPA numbers must come from a
# revision with it OFF (D-2: Lab 5 reported 483,328 bits where the design uses
# 131,072).
set_global_assignment -name ENABLE_SIGNALTAP ON
set_global_assignment -name USE_SIGNALTAP_FILE stp_pwm.stp
set_global_assignment -name SIGNALTAP_FILE stp_pwm.stp

# REMOVED 2026-08-27: this line was
#     set_global_assignment -name SLD_FILE db/stp_pwm_auto_stripped.stp
# It points into db/, which is Quartus's own build output -- present on the
# machine that last compiled and in no clean clone, no ZIP, and no inspection-
# room download. Clause 10 forbids "files that are a result of compilation" in
# the submission, so db/ cannot be shipped to satisfy it either. Quartus writes
# this line itself when it processes the .stp, so removing it costs nothing and
# a fresh compile from the packaged files no longer starts with a missing file.

set_global_assignment -name POWER_DEFAULT_TOGGLE_RATE 12.5%
set_global_assignment -name POWER_DEFAULT_INPUT_IO_TOGGLE_RATE 12.5%
set_global_assignment -name SLD_NODE_CREATOR_ID 110 -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_ENTITY_NAME sld_signaltap -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_clk -to clk_i -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_trigger_in[0] -to GPIO[9] -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_trigger_in[1] -to KEY_i[1] -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_trigger_in[2] -to KEY_i[2] -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_trigger_in[3] -to KEY_i[3] -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_data_in[0] -to GPIO[9] -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_data_in[1] -to KEY_i[1] -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_data_in[2] -to KEY_i[2] -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_data_in[3] -to KEY_i[3] -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_RAM_BLOCK_TYPE=AUTO" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_DATA_BITS=4" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_TRIGGER_BITS=4" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_STORAGE_QUALIFIER_BITS=4" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_NODE_INFO=805334528" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_POWER_UP_TRIGGER=0" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_INVERSION_MASK=0000000000000000000000000000000000000000" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_INVERSION_MASK_LENGTH=40" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_STORAGE_QUALIFIER_INVERSION_MASK_LENGTH=0" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_SEGMENT_SIZE=16384" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_ATTRIBUTE_MEM_MODE=OFF" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_STATE_FLOW_USE_GENERATED=0" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_STATE_BITS=11" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_BUFFER_FULL_STOP=1" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_CURRENT_RESOURCE_WIDTH=1" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_INCREMENTAL_ROUTING=1" -section_id auto_signaltap_0
set_instance_assignment -name POST_FIT_CONNECT_TO_SLD_NODE_ENTITY_PORT crc[0] -to auto_signaltap_0|gnd -section_id auto_signaltap_0
set_instance_assignment -name POST_FIT_CONNECT_TO_SLD_NODE_ENTITY_PORT crc[1] -to auto_signaltap_0|vcc -section_id auto_signaltap_0
set_instance_assignment -name POST_FIT_CONNECT_TO_SLD_NODE_ENTITY_PORT crc[2] -to auto_signaltap_0|gnd -section_id auto_signaltap_0
