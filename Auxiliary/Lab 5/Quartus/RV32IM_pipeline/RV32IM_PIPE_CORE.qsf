set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

#================================================================================
# DE2-115 pin assignments (per LAB5 task definition: single clk_i, KEY0 = reset,
# BPADDR_i fed by SW7-SW0). Locations per Terasic DE2-115 User Manual, Table 4-2/4-3.
#================================================================================
# clk_i -> CLOCK_50
set_location_assignment PIN_Y2 -to clk_i
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_i

# rst_i -> KEY0 (push-button, active-low: idle='1', pressed='0')
set_location_assignment PIN_M23 -to rst_i
set_instance_assignment -name IO_STANDARD "2.5 V" -to rst_i

# BPADDR_i[7:0] -> SW7-SW0
set_location_assignment PIN_AB28 -to BPADDR_i[0]
set_location_assignment PIN_AC28 -to BPADDR_i[1]
set_location_assignment PIN_AC27 -to BPADDR_i[2]
set_location_assignment PIN_AD27 -to BPADDR_i[3]
set_location_assignment PIN_AB27 -to BPADDR_i[4]
set_location_assignment PIN_AC26 -to BPADDR_i[5]
set_location_assignment PIN_AD26 -to BPADDR_i[6]
set_location_assignment PIN_AB26 -to BPADDR_i[7]
set_instance_assignment -name IO_STANDARD "2.5 V" -to BPADDR_i[0]
set_instance_assignment -name IO_STANDARD "2.5 V" -to BPADDR_i[1]
set_instance_assignment -name IO_STANDARD "2.5 V" -to BPADDR_i[2]
set_instance_assignment -name IO_STANDARD "2.5 V" -to BPADDR_i[3]
set_instance_assignment -name IO_STANDARD "2.5 V" -to BPADDR_i[4]
set_instance_assignment -name IO_STANDARD "2.5 V" -to BPADDR_i[5]
set_instance_assignment -name IO_STANDARD "2.5 V" -to BPADDR_i[6]
set_instance_assignment -name IO_STANDARD "2.5 V" -to BPADDR_i[7]
#================================================================================
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
